-- MODEL


type alias Absence =
    { absenceType : Maybe AbsenceType
    , approvedAt : Maybe Posix
    , approvedBy : Maybe Uuid
    , createdAt : Maybe Posix
    , deletedAt : Maybe Posix
    , employeeId : Maybe Uuid
    , endDate : Maybe Posix
    , id : Maybe Uuid
    , notes : Maybe String
    , startDate : Maybe Posix
    , status : Maybe AbsenceStatus
    , tenantId : Maybe Uuid
    , updatedAt : Maybe Posix
    }


type alias AbsenceCreate =
    { absenceType : Maybe AbsenceType
    , approvedAt : Maybe Posix
    , approvedBy : Maybe Uuid
    , employeeId : Maybe Uuid
    , endDate : Maybe Posix
    , notes : Maybe String
    , startDate : Maybe Posix
    , status : Maybe AbsenceStatus
    }


{-| Absence request status.
-}
type AbsenceStatus
    = AbsenceStatusPending
    | AbsenceStatusApproved
    | AbsenceStatusRejected
    | AbsenceStatusCancelled


absenceStatusVariants : List AbsenceStatus
absenceStatusVariants =
    [ AbsenceStatusPending
    , AbsenceStatusApproved
    , AbsenceStatusRejected
    , AbsenceStatusCancelled
    ]


{-| Absence type.
-}
type AbsenceType
    = AbsenceTypeVacation
    | AbsenceTypeSick
    | AbsenceTypeSabbatical
    | AbsenceTypeParental
    | AbsenceTypeOther


absenceTypeVariants : List AbsenceType
absenceTypeVariants =
    [ AbsenceTypeVacation
    , AbsenceTypeSick
    , AbsenceTypeSabbatical
    , AbsenceTypeParental
    , AbsenceTypeOther
    ]


type alias AbsenceUpdate =
    { absenceType : Maybe AbsenceType
    , approvedAt : Maybe Posix
    , approvedBy : Maybe Uuid
    , employeeId : Maybe Uuid
    , endDate : Maybe Posix
    , notes : Maybe String
    , startDate : Maybe Posix
    , status : Maybe AbsenceStatus
    }


type alias AcceptInviteRequest =
    { firstName : String
