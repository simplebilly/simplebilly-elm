absenceStatusDecoder : Json.Decode.Decoder AbsenceStatus
absenceStatusDecoder =
    Json.Decode.string
        |> Json.Decode.andThen
            (\value ->
                case value of
                    "pending" ->
                        Json.Decode.succeed AbsenceStatusPending

                    "approved" ->
                        Json.Decode.succeed AbsenceStatusApproved

                    "rejected" ->
                        Json.Decode.succeed AbsenceStatusRejected

                    "cancelled" ->
                        Json.Decode.succeed AbsenceStatusCancelled

                    other ->
                        Json.Decode.fail <| "Unknown type: " ++ other
            )


absenceTypeDecoder : Json.Decode.Decoder AbsenceType
absenceTypeDecoder =
    Json.Decode.string
        |> Json.Decode.andThen
            (\value ->
                case value of
                    "vacation" ->
                        Json.Decode.succeed AbsenceTypeVacation

                    "sick" ->
                        Json.Decode.succeed AbsenceTypeSick

                    "sabbatical" ->
                        Json.Decode.succeed AbsenceTypeSabbatical

                    "parental" ->
                        Json.Decode.succeed AbsenceTypeParental

                    "other" ->
                        Json.Decode.succeed AbsenceTypeOther

                    other ->
                        Json.Decode.fail <| "Unknown type: " ++ other
            )


