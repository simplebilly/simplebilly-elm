    case model of
        OrderStatusPending ->
            "pending"

        OrderStatusOrdered ->
            "ordered"

        OrderStatusConfirmed ->
            "confirmed"

        OrderStatusProcessing ->
            "processing"

        OrderStatusPaid ->
            "paid"

        OrderStatusShipped ->
            "shipped"

        OrderStatusCompleted ->
            "completed"

        OrderStatusClosed ->
            "closed"

        OrderStatusCancelled ->
            "cancelled"

        OrderStatusRefunded ->
            "refunded"

        OrderStatusFailed ->
            "failed"


