voucherStatusDecoder : Json.Decode.Decoder VoucherStatus
voucherStatusDecoder =
    Json.Decode.string
        |> Json.Decode.andThen
            (\value ->
                case value of
                    "open" ->
                        Json.Decode.succeed VoucherStatusOpen

                    "paid" ->
                        Json.Decode.succeed VoucherStatusPaid

                    "invoiced" ->
                        Json.Decode.succeed VoucherStatusInvoiced

                    other ->
                        Json.Decode.fail <| "Unknown type: " ++ other
            )


