couponDecoder : Json.Decode.Decoder Coupon
couponDecoder =
    Json.Decode.succeed Coupon
        |> decode "code" Json.Decode.string 
        |> maybeDecodeNullable "description" Json.Decode.string Nothing
        |> decode "discountType" discountTypeDecoder 
        |> decode "discountValue" Json.Decode.string 
        |> maybeDecodeNullable "expiresAt" Api.Time.dateTimeDecoder Nothing
        |> maybeDecode "isActive" Json.Decode.bool Nothing
        |> maybeDecode "isCombineable" Json.Decode.bool Nothing
        |> maybeDecodeNullable "maxDiscountAmount" Json.Decode.string Nothing
        |> maybeDecodeNullable "maxUses" Json.Decode.int Nothing
        |> maybeDecodeNullable "maxUsesPerCustomer" Json.Decode.int Nothing
        |> maybeDecodeNullable "minOrderAmount" Json.Decode.string Nothing
        |> maybeDecodeNullable "productIds" anyTypeDecoder Nothing
        |> maybeDecodeNullable "startsAt" Api.Time.dateTimeDecoder Nothing


